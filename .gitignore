# Python caches
__pycache__/
*.py[cod]

# Meson and test output
build/
meson-logs/
meson-private/

# Cargo build output. Cargo.lock is deliberately NOT ignored: this is an
# application, and the Flatpak build resolves its dependencies from that lock
# file (DECISIONS D-04, D-09).
/target

# Flatpak builder and bundle output
.flatpak-builder/
build-flatpak/
flatpak-repo/
dist/

# Editor and OS files
.DS_Store
.idea/
.vscode/
*.swp
# Claude Code agent worktrees. Scratch checkouts of this repository, one per
# dispatched agent; they are not part of the tree and their contents are
# throwaway. Ignored so `git status` stays a real signal during the audit.
.claude/worktrees/

# The aiohttp+tomlkit venv verify.sh's cargo-sources-fresh stage prefers
# (find_generator_python looks for venv/bin/python beside the vendored
# generator). A created interpreter, not source.
build-aux/flatpak/venv/

# Generated by scripts/package-flatpak.sh --arch aarch64: the manifest variant
# with the x86_64-only Wine base/i386-compat/DXVK entries removed. Lives beside
# the source manifest so its relative sources resolve.
build-aux/flatpak/com.goshapps.GameHandler.aarch64.json
