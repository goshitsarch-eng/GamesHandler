{
  "app-id": "com.goshapps.GameHandler",
  "branch": "stable",
  "appstream-compose": false,
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "25.08",
  "sdk": "org.freedesktop.Sdk",
  "sdk-extensions": [
    "org.freedesktop.Sdk.Extension.rust-stable"
  ],
  "base": "org.winehq.Wine",
  "base-version": "stable-25.08",
  "command": "gamehandler",
  "finish-args": [
    "--share=network",
    "--share=ipc",
    "--socket=fallback-x11",
    "--socket=wayland",
    "--socket=pulseaudio",
    "--allow=multiarch",
    "--device=dri",
    "--device=input",
    "--device=usb",
    "--filesystem=home:ro",
    "--filesystem=~/.local/share/applications:create",
    "--filesystem=xdg-run/gvfs",
    "--filesystem=~/.var/app/com.valvesoftware.Steam/data/Steam:ro",
    "--env=PATH=/usr/lib/extensions/vulkan/gamescope/bin:/app/bin:/usr/bin"
  ],
  "inherit-extensions": [
    "org.freedesktop.Platform.GL32",
    "org.freedesktop.Platform.Compat.i386"
  ],
  "cleanup": [
    "/include",
    "/lib/cmake",
    "/lib/pkgconfig",
    "/share/doc"
  ],
  "modules": [
    {
      "name": "osslsigncode",
      "buildsystem": "cmake-ninja",
      "config-opts": [
        "-DCMAKE_BUILD_TYPE=Release",
        "-DBASH_COMPLETION_USER_DIR=/app/share"
      ],
      "post-install": [
        "install -Dm644 LICENSE.txt /app/share/licenses/com.goshapps.GameHandler/osslsigncode-LICENSE.txt"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://github.com/mtrojnar/osslsigncode/archive/refs/tags/2.14.tar.gz",
          "sha256": "0f033fd6069387d2e489fbd2187e62f624764eb8c2758ee94e3e793e5150b5c5"
        }
      ]
    },
    {
      "name": "dxvk-runtime",
      "buildsystem": "simple",
      "build-commands": [
        "mkdir -p /app/share/gamehandler/dxvk /app/share/licenses/com.goshapps.GameHandler",
        "cp -a x32 x64 /app/share/gamehandler/dxvk/",
        "install -Dm644 DXVK-LICENSE /app/share/licenses/com.goshapps.GameHandler/DXVK.txt"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://github.com/doitsujin/dxvk/releases/download/v3.0.2/dxvk-3.0.2.tar.gz",
          "sha256": "9c538924110a7cdef871ca36dee218c0774124374ffdeb38af4b76be55bdf7c2"
        },
        {
          "type": "file",
          "url": "https://raw.githubusercontent.com/doitsujin/dxvk/v3.0.2/LICENSE",
          "sha256": "a5cb1a6ded7d2d7e92d550ba28edd21be2d1d4044662b399887351023e30ce64",
          "dest-filename": "DXVK-LICENSE"
        }
      ]
    },
    {
      "name": "gamehandler",
      "buildsystem": "simple",
      "build-options": {
        "append-path": "/usr/lib/sdk/rust-stable/bin",
        "env": {
          "CARGO_HOME": "/run/build/gamehandler/cargo",
          "CARGO_NET_OFFLINE": "true"
        }
      },
      "build-commands": [
        "cargo --offline fetch --locked --manifest-path Cargo.toml --verbose",
        "cargo --offline build --locked --release",
        "install -Dm0755 target/release/gamehandler ${FLATPAK_DEST}/bin/gamehandler",
        "install -Dm0644 data/com.goshapps.GameHandler.desktop ${FLATPAK_DEST}/share/applications/com.goshapps.GameHandler.desktop",
        "install -Dm0644 data/com.goshapps.GameHandler.metainfo.xml ${FLATPAK_DEST}/share/metainfo/com.goshapps.GameHandler.metainfo.xml",
        "install -Dm0644 data/icons/hicolor/scalable/apps/com.goshapps.GameHandler.svg ${FLATPAK_DEST}/share/icons/hicolor/scalable/apps/com.goshapps.GameHandler.svg",
        "install -Dm0644 data/icons/hicolor/64x64/apps/com.goshapps.GameHandler.png ${FLATPAK_DEST}/share/icons/hicolor/64x64/apps/com.goshapps.GameHandler.png",
        "install -Dm0644 data/icons/hicolor/128x128/apps/com.goshapps.GameHandler.png ${FLATPAK_DEST}/share/icons/hicolor/128x128/apps/com.goshapps.GameHandler.png",
        "install -Dm0644 data/icons/hicolor/256x256/apps/com.goshapps.GameHandler.png ${FLATPAK_DEST}/share/icons/hicolor/256x256/apps/com.goshapps.GameHandler.png",
        "install -Dm0644 data/icons/hicolor/512x512/apps/com.goshapps.GameHandler.png ${FLATPAK_DEST}/share/icons/hicolor/512x512/apps/com.goshapps.GameHandler.png",
        "install -Dm0644 LICENSE ${FLATPAK_DEST}/share/licenses/com.goshapps.GameHandler/LICENSE",
        "install -Dm0644 data/microsoft-identity-verification-root-ca-2020.pem ${FLATPAK_DEST}/share/gamehandler/microsoft-identity-verification-root-ca-2020.pem"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "../..",
          "skip": [
            ".git",
            ".flatpak-builder",
            "build-flatpak",
            "flatpak-repo",
            "dist",
            "target"
          ]
        },
        "cargo-sources.json"
      ]
    }
  ]
}
