{
  "app-id": "com.goshapps.GameHandler",
  "branch": "stable",
  "runtime": "org.gnome.Platform",
  "runtime-version": "50",
  "sdk": "org.gnome.Sdk",
  "base": "org.winehq.Wine",
  "base-version": "stable-25.08",
  "command": "gamehandler",
  "finish-args": [
    "--share=network",
    "--share=ipc",
    "--socket=fallback-x11",
    "--socket=wayland",
    "--socket=pulseaudio",
    "--allow=multiarch",
    "--device=all",
    "--filesystem=home",
    "--talk-name=org.freedesktop.Notifications"
  ],
  "inherit-extensions": [
    "org.freedesktop.Platform.GL32",
    "org.freedesktop.Platform.Compat.i386"
  ],
  "modules": [
    {
      "name": "gamehandler",
      "buildsystem": "meson",
      "sources": [
        {
          "type": "dir",
          "path": "../.."
        }
      ]
    }
  ]
}
