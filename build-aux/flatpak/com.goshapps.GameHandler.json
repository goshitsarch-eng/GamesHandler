{
  "app-id": "com.goshapps.GameHandler",
  "branch": "stable",
  "runtime": "org.kde.Platform",
  "runtime-version": "6.10",
  "sdk": "org.kde.Sdk",
  "sdk-extensions": [
    "org.freedesktop.Sdk.Extension.llvm21"
  ],
  "base": "org.winehq.Wine",
  "base-version": "stable-25.08",
  "command": "gamehandler",
  "finish-args": [
    "--share=network",
    "--share=ipc",
    "--socket=fallback-x11",
    "--socket=wayland",
    "--socket=pulseaudio",
    "--allow=multiarch",
    "--device=all",
    "--filesystem=home",
    "--filesystem=xdg-run/gvfs",
    "--filesystem=~/.var/app/com.valvesoftware.Steam/data/Steam:ro",
    "--env=PATH=/usr/lib/extensions/vulkan/gamescope/bin:/app/bin:/usr/bin",
    "--env=PYTHONPATH=/app/lib/python3.13/site-packages",
    "--talk-name=org.freedesktop.Notifications"
  ],
  "inherit-extensions": [
    "org.freedesktop.Platform.GL32",
    "org.freedesktop.Platform.Compat.i386"
  ],
  "cleanup": [
    "/include",
    "/lib/cmake",
    "/lib/pkgconfig",
    "/share/doc"
  ],
  "modules": [
    "python3-pyside-requirements.json",
    {
      "name": "pyside6",
      "buildsystem": "simple",
      "build-options": {
        "append-path": "/usr/lib/sdk/llvm21/bin",
        "append-ld-library-path": "/usr/lib/sdk/llvm21/lib",
        "env": {
          "LLVM_INSTALL_DIR": "/usr/lib/sdk/llvm21",
          "SHIBOKEN_DEBUG_LEVEL": "full"
        }
      },
      "build-commands": [
        "python3 setup.py build --qtpaths=/usr/bin/qtpaths --ignore-git --parallel=1 --log-level=verbose --flatpak --module-subset=Core,Gui,Widgets,Network,OpenGL,Qml,Quick,QuickControls2,Svg",
        "python3 create_wheels.py --build-dir ./build/qfp-*-release",
        "rm -rf ./dist/pyside6*examples*.whl",
        "pip3 install ./dist/*.whl --prefix=${FLATPAK_DEST}",
        "install -Dm755 /usr/lib/sdk/llvm21/lib/libLLVM.so.21.1 ${FLATPAK_DEST}/lib/",
        "install -Dm755 /usr/lib/sdk/llvm21/lib/libclang-cpp.so.21.1 ${FLATPAK_DEST}/lib/",
        "install -Dm755 /usr/lib/sdk/llvm21/lib/libclang.so.21.1 ${FLATPAK_DEST}/lib/",
        "ln -s libLLVM.so.21.1 ${FLATPAK_DEST}/lib/libLLVM.so.21",
        "ln -s libLLVM.so.21.1 ${FLATPAK_DEST}/lib/libLLVM.so",
        "ln -s libclang-cpp.so.21.1 ${FLATPAK_DEST}/lib/libclang-cpp.so.21",
        "ln -s libclang-cpp.so.21.1 ${FLATPAK_DEST}/lib/libclang-cpp.so",
        "ln -s libclang.so.21.1 ${FLATPAK_DEST}/lib/libclang.so.21",
        "ln -s libclang.so.21.1 ${FLATPAK_DEST}/lib/libclang.so",
        "rm -rf ${FLATPAK_DEST}/lib/python*/site-packages/PySide6/examples",
        "rm -rf ${FLATPAK_DEST}/lib/python*/site-packages/pyside6_examples-*.dist-info"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://download.qt.io/official_releases/QtForPython/pyside6/PySide6-6.10.3-src/pyside-setup-everywhere-src-6.10.3.tar.xz",
          "sha256": "2c7462fe0cecb5b8ac0a3d92014b8d0b88bd4d9f8646709dab5286d9416f45bc"
        }
      ]
    },
    {
      "name": "osslsigncode",
      "buildsystem": "cmake-ninja",
      "config-opts": [
        "-DCMAKE_BUILD_TYPE=Release",
        "-DBASH_COMPLETION_USER_DIR=/app/share"
      ],
      "post-install": [
        "install -Dm644 LICENSE.txt /app/share/licenses/com.goshapps.GameHandler/osslsigncode-LICENSE.txt"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://github.com/mtrojnar/osslsigncode/archive/refs/tags/2.14.tar.gz",
          "sha256": "0f033fd6069387d2e489fbd2187e62f624764eb8c2758ee94e3e793e5150b5c5"
        }
      ]
    },
    {
      "name": "dxvk-runtime",
      "buildsystem": "simple",
      "build-commands": [
        "mkdir -p /app/share/gamehandler/dxvk /app/share/licenses/com.goshapps.GameHandler",
        "cp -a x32 x64 /app/share/gamehandler/dxvk/",
        "install -Dm644 DXVK-LICENSE /app/share/licenses/com.goshapps.GameHandler/DXVK.txt"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://github.com/doitsujin/dxvk/releases/download/v3.0.2/dxvk-3.0.2.tar.gz",
          "sha256": "9c538924110a7cdef871ca36dee218c0774124374ffdeb38af4b76be55bdf7c2"
        },
        {
          "type": "file",
          "url": "https://raw.githubusercontent.com/doitsujin/dxvk/v3.0.2/LICENSE",
          "sha256": "a5cb1a6ded7d2d7e92d550ba28edd21be2d1d4044662b399887351023e30ce64",
          "dest-filename": "DXVK-LICENSE"
        }
      ]
    },
    {
      "name": "gamehandler",
      "buildsystem": "meson",
      "sources": [
        {
          "type": "dir",
          "path": "../.."
        }
      ]
    }
  ]
}
