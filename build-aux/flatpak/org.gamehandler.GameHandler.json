{
  "app-id": "org.gamehandler.GameHandler",
  "runtime": "org.gnome.Platform",
  "runtime-version": "47",
  "sdk": "org.gnome.Sdk",
  "command": "gamehandler",
  "finish-args": [
    "--share=network",
    "--share=ipc",
    "--socket=fallback-x11",
    "--socket=wayland",
    "--socket=pulseaudio",
    "--device=all",
    "--filesystem=home",
    "--filesystem=xdg-data/gamehandler:create",
    "--talk-name=org.freedesktop.Notifications"
  ],
  "modules": [
    {
      "name": "gamehandler",
      "buildsystem": "meson",
      "sources": [
        {
          "type": "dir",
          "path": "../.."
        }
      ]
    }
  ]
}
